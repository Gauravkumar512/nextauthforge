{
  "name": "nextauthforge",
  "version": "2.0.0-alpha.0",
  "description": "Plug-and-play authentication scaffolding tool for Next.js App Router",
  "main": "dist/index.js",
  "bin": {
    "nextauthforge": "bin/index.js"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node bin/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "nextjs",
    "auth",
    "authentication",
    "scaffold",
    "jwt",
    "mongodb",
    "cli"
  ],
  "author": "Gaurav Kumar <gauravskumar03@gmail.com> (https://github.com/Gauravkumar512)",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.3.0",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "fs-extra": "^11.4.1",
    "inquirer": "^12.11.1",
    "ora": "^8.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gauravkumar512/nextauthforge.git"
  },
  "bugs": {
    "url": "https://github.com/Gauravkumar512/nextauthforge/issues"
  },
  "homepage": "https://github.com/Gauravkumar512/nextauthforge#readme",
  "engines": {
    "node": ">=18.18"
  }
}
