# Connection string for your MongoDB database (local or Atlas).
# Example: mongodb+srv://<user>:<pass>@cluster.mongodb.net/dbname
DATABASE_URL=

# Secret used to sign session JWTs. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# Optional: override the session cookie name (default: "token").
# COOKIE_NAME=token
