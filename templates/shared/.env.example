# Connection string for your MongoDB database (local or Atlas).
# Example: mongodb+srv://<user>:<pass>@cluster.mongodb.net/dbname
DATABASE_URL=

# Secret used to sign session JWTs. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# Public base URL of your app, used for the links in emails.
# Set it to your real domain in production.
APP_URL=http://localhost:3000

# How emails are sent: smtp | resend | console.
# "console" only prints emails (with their links) to the server log in
# development and refuses to run in production.
EMAIL_PROVIDER=console

# Sender address, e.g. My App <noreply@example.com>. Required for smtp and resend.
EMAIL_FROM=

# Optional: override the session cookie name (default: "token").
# COOKIE_NAME=token
